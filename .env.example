# ============================================================
# PatchPilot — Global Environment Configuration Template
# For Docker Compose and full-stack local development.
# Copy this file to .env and configure as needed.
# NEVER commit real credentials to Git.
# ============================================================

# --- FalkorDB Database Configuration ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=patchpilot

# --- Backend API Service ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://localhost:8000

# --- Optional AI/LLM Provider ---
# Options: "deterministic" (default, no API key needed), "openai", "anthropic"
# Core graph traversal and prioritization scoring work 100% in deterministic mode.
LLM_PROVIDER=deterministic

# OpenAI Credentials (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Credentials (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
